# Copy to .env and fill in credentials. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
# For Claude set LLM_PROVIDER=anthropic and a Claude model.
# OpenAI-compatible gateways (such as OpenRouter or Kimi) use openai plus their base URL and key.

# Public ERP base URLs. The upload's college_id is added to every request.
SUBJECT_API_BASE_URL=https://erp.tint.edu.in/api/public/subjects
FACULTY_API_BASE_URL=https://erp.tint.edu.in/api/public/employee-list
# Optional group and section sources; leave empty until their API contracts are available.
GROUP_API_BASE_URL=
SECTION_API_BASE_URL=
# These public APIs do not require a key. Set this only if future APIs do.
MASTER_API_KEY=
MASTER_API_AUTH_HEADER=Authorization
MASTER_API_AUTH_SCHEME=Bearer
MASTER_CACHE_TTL_SECONDS=300

MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20
MAX_WORKBOOK_CELLS=25000
MAX_WORKBOOK_CHARACTERS=200000
PDF_RENDER_DPI=120
LLM_TIMEOUT_SECONDS=180
HTTP_TIMEOUT_SECONDS=30
OUTPUT_DIR=output

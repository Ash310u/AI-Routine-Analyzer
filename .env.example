# Copy to .env and fill in credentials. Never commit .env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
# For Claude set LLM_PROVIDER=anthropic and a Claude model.
# OpenAI-compatible gateways (such as OpenRouter or Kimi) use openai plus their base URL and key.

# Public ERP endpoints. Keep the query parameters because they scope the cache.
SUBJECT_API_URL=https://erp.tint.edu.in/api/public/subjects?college_id=2
# The supplied department_id=2 URL currently returns Admin employees; they are excluded from faculty matching.
FACULTY_API_URL=https://erp.tint.edu.in/api/public/employee-list?college_id=1&department_id=2
# Optional student/group/section sources; leave empty until their API contracts are available.
GROUP_API_URL=
SECTION_API_URL=
NSEC_SUBJECT_API_URL=https://erp.tint.edu.in/api/public/subjects?college_id=1
NSEC_FACULTY_API_URL=https://erp.tint.edu.in/api/public/employee-list?college_id=1&department_id=1
NSEC_GROUP_API_URL=
NSEC_SECTION_API_URL=
# These public APIs do not require a key. Set this only if future APIs do.
MASTER_API_KEY=
MASTER_API_AUTH_HEADER=Authorization
MASTER_API_AUTH_SCHEME=Bearer
MASTER_CACHE_TTL_SECONDS=300

MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20
MAX_WORKBOOK_CELLS=25000
MAX_WORKBOOK_CHARACTERS=200000
PDF_RENDER_DPI=120
LLM_TIMEOUT_SECONDS=180
HTTP_TIMEOUT_SECONDS=30
OUTPUT_DIR=output
